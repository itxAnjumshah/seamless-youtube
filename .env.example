# Optional comma-separated list of additional domains that your organization owns.
AUTHORIZED_VIDEO_HOSTS=

# Optional: help YouTube accept requests from cloud hosts like Render.
# Paste your browser Cookie header from youtube.com (never commit real cookies).
YOUTUBE_COOKIE=

# Optional session values from a YouTube player request (visitorData / poToken).
YOUTUBE_VISITOR_DATA=
YOUTUBE_PO_TOKEN=
